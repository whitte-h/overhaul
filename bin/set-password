#!/usr/bin/env bash
# Sets the hub login password (HUB_TOKEN) without echoing it, then restarts the hub.
# Usage, on the hub host:  bin/set-password [--no-restart]   (install.sh uses --no-restart)
# From another computer:   ssh -t <hub host> '<repo>/bin/set-password'
set -euo pipefail

restart=1
[ "${1:-}" = "--no-restart" ] && restart=0

# Same folder as the hub (src/env.mjs): explicit, else ~/.config/overhaul, else the pre-rename one.
CONFIG_DIR="${OVERHAUL_CONFIG_DIR:-${HUB_CONFIG_DIR:-}}"
if [ -z "$CONFIG_DIR" ]; then
  CONFIG_DIR="$HOME/.config/overhaul"
  [ ! -e "$CONFIG_DIR" ] && [ -d "$HOME/.config/work-hub" ] && CONFIG_DIR="$HOME/.config/work-hub"
fi
ENV_FILE="$CONFIG_DIR/env"
# The variable the hub reads the password from: config.yaml `auth: { password_env: X }`, else HUB_TOKEN.
VAR=$(sed -n 's/.*password_env:[[:space:]]*"\{0,1\}\([A-Z0-9_]*\).*/\1/p' "$CONFIG_DIR/config.yaml" 2>/dev/null | head -1)
VAR=${VAR:-HUB_TOKEN}
[ -f "$ENV_FILE" ] || { echo "No existe $ENV_FILE" >&2; exit 1; }

read -rsp "Nueva contraseña (12+ caracteres): " p1; echo
read -rsp "Repítela: " p2; echo
[ "$p1" = "$p2" ] || { echo "No coinciden; no cambié nada." >&2; exit 1; }
[ "${#p1}" -ge 12 ] || { echo "Muy corta (${#p1}); mínimo 12. No cambié nada." >&2; exit 1; }
case "$p1" in *$'\n'*|" "*|*" ") echo "Sin saltos de línea ni espacios al inicio o final." >&2; exit 1 ;; esac

# Rewrite only that line; the value goes through the environment, never argv.
# node, not python3: a fresh Mac has no python3, and the hub needs node anyway.
HUB_NEW_PASSWORD="$p1" node - "$ENV_FILE" "$VAR" <<'JS'
const fs = require("node:fs");
const [file, name] = process.argv.slice(2);
const line = name + "=" + process.env.HUB_NEW_PASSWORD;
const re = new RegExp("^" + name + "=.*$", "m");
let text = fs.readFileSync(file, "utf8");
text = re.test(text) ? text.replace(re, () => line) : line + "\n" + text;
fs.writeFileSync(file + ".tmp", text, { mode: 0o600 });
fs.chmodSync(file + ".tmp", 0o600);
fs.renameSync(file + ".tmp", file);
JS

# Whichever hub service this machine runs: overhaul, or one from an earlier installation.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/deploy/labels.sh"
restart_hub() {
  if [ "$(uname -s)" = Darwin ]; then
    local agents="$HOME/Library/LaunchAgents" label
    for label in "$OVERHAUL_HUB_LABEL" $(previous_launch_agents "$agents" hub); do
      [ "$label" = "$OVERHAUL_HUB_LABEL" ] || grep -q 'server\.mjs' "$agents/$label.plist" 2>/dev/null || continue
      launchctl kickstart -k "gui/$(id -u)/$label" 2>/dev/null && return
    done
  elif command -v systemctl >/dev/null; then
    for unit in overhaul work-hub; do
      systemctl --user cat "$unit.service" >/dev/null 2>&1 && { systemctl --user restart "$unit"; return; }
    done
  fi
  echo "No encontré el servicio del hub; reinícialo a mano para que tome la contraseña."
}
[ "$restart" = 1 ] || { echo "Contraseña guardada en $ENV_FILE."; exit 0; }
restart_hub
echo "Listo. Entra de nuevo en el hub con la contraseña nueva (se cerraron las sesiones abiertas)."
