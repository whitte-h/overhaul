# Standalone Overhaul bridge: pastes hub messages into this machine's tmux (host = this machine).
[Unit]
Description=Overhaul bridge (standalone)
After=overhaul.service

[Service]
ExecStart=__NODE__ __DIR__/bin/hub.mjs bridge
Environment="PATH=__PATH__"
Environment="HUB_CONFIG_DIR=__CONFIG_DIR__"
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
