<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Desktop helper (install.sh fills __NODE__, __DIR__ and __LABEL__): at login, opens Orca and
     rebuilds Overhaul's layout in it (~/.config/overhaul/orca-layout.json): projects, hub tabs
     and agent terminals. Idempotent; runs once per login. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__DIR__/orca-restore.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/overhaul-orca.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/overhaul-orca.log</string>
</dict>
</plist>
